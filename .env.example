# 答题记录数据库（SQL Server）。默认本机 LocalDB 实例 + Windows 集成认证；
# 换正式实例/云端时改这里即可，代码零改动：
MSSQL_SERVER=(localdb)\MSSQLLocalDB
MSSQL_DATABASE=AITeacherDB
# 使用 SQL 账号时填写（留空则用 Windows 集成认证）：
MSSQL_USER=
MSSQL_PASSWORD=
# 记录通道：auto（默认，ODBC 探测失败自动降级 sqlcmd）| odbc | sqlcmd | off
DB_TRANSPORT=auto
